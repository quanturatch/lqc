# Supabase Postgres connection. Replace [YOUR-PASSWORD] with the database password.
# If the password contains characters such as @ # / or :, URL-encode them.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.gbelsmvfkewnowetphmw.supabase.co:5432/postgres

# Long random string. Used to hash sign-in codes and session cookies.
SESSION_SECRET=replace-with-a-long-random-string

# OTP email. The app signs in as the real mailbox and sends from the alias.
# Gmail: add the alias under Settings → Accounts → Send mail as.
# The app password is for the real mailbox (Google Account → Security → App passwords).
EMAIL_ADDRESS=
EMAIL_ALIAS=
EMAIL_APP_PASSWORD=
# Optional. Blank uses smtp.gmail.com. Use smtp.office365.com for Outlook.
SMTP_HOST=
SMTP_PORT=587

# Optional. Used only when the three EMAIL_ values above are empty.
RESEND_API_KEY=

# Set to 1 only on your own machine to show the code on screen when email is not configured.
OTP_DEBUG=
